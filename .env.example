# Copy to backend/.env for local development. backend/.env is git-ignored.
# In Azure, these come from Container Apps settings; secrets come from Key Vault references.
# NEVER put real secrets in this file or commit them anywhere.

KA_APP_ENV=development
KA_DATABASE_URL=sqlite:///./local.db
# Production example (password comes from Key Vault, not here):
# KA_DATABASE_URL=postgresql+psycopg://kaadmin:<from-key-vault>@<server>.postgres.database.azure.com:5432/kaamka?sslmode=require

KA_OWNER_EMAIL=you@example.com
# Local only: sign in as the owner without Entra ID. Refused when KA_APP_ENV=production.
KA_DEV_AUTH_BYPASS=true

KA_MONTHLY_BUDGET_INR=4000
KA_MAX_POSTS_PER_DAY=3

# Phase 4 (AI content) — leave blank until then.
KA_AZURE_OPENAI_ENDPOINT=
KA_AZURE_OPENAI_API_KEY=
KA_AZURE_OPENAI_DEPLOYMENT=

# Phase 6 (Instagram) — leave blank until then.
KA_INSTAGRAM_APP_SECRET=
KA_TOKEN_ENCRYPTION_KEY=
